name: Deploy OmniRID app to GitHub Pages

on:
  push:
    branches:
      - omnirid-webapp-pwa
    paths:
      - 'OmniRID-app/**'
      - '.github/workflows/deploy-omnirid-app.yml'
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: github-pages
  cancel-in-progress: true

jobs:
  build:
    name: Build OmniRID app
    runs-on: ubuntu-latest
    env:
      NUXT_APP_BASE_URL: /OmniRID-Universal-Drone-ID/
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 12.4.1

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: pnpm
          cache-dependency-path: OmniRID-app/pnpm-lock.yaml

      - name: Install dependencies
        working-directory: OmniRID-app
        run: pnpm install --frozen-lockfile

      - name: Build static app
        working-directory: OmniRID-app
        run: pnpm build

      - name: Upload GitHub Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: OmniRID-app/.output/public

  deploy:
    name: Deploy to GitHub Pages
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy Pages artifact
        id: deployment
        uses: actions/deploy-pages@v4
