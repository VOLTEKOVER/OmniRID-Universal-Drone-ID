# ESP-IDF SDK config for the Remote ID firmware.
#
# Without these the esp-idf-sys bindings omit every Bluetooth / Bluedroid
# symbol (esp_bt_*, esp_ble_*, esp_bluedroid_*) and the USB Serial/JTAG
# driver (usb_serial_jtag_*), which the bsp-esp32 firmware needs.
#
# CONFIG_BT_BLE_42_FEATURES_SUPPORTED is required so the legacy-adv symbols
# (esp_ble_gap_start_advertising, esp_ble_adv_params_t,
# esp_ble_gap_config_adv_data_raw) are emitted even on BLE-5 chips (s3/c6).
# CONFIG_BT_BLE_50_FEATURES_SUPPORTED is left to its per-chip default
# (y on esp32s3/esp32c6, unavailable on classic esp32).

CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_BLE_SMP_ENABLE=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# BLE 5.0 extended advertising (PHY enum + ext-adv API) is required by
# `ble.rs::transmit_extended` on ESP32-S3/C6.  The option was renamed
# `CONFIG_BT_BLE_50_EXTEND_ADV_EN` -> `CONFIG_BT_BLE_EXT_ADV` in newer IDF; we
# set both (kconfig ignores the one that does not exist for the IDF in use).
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_EXTEND_ADV_EN=y
CONFIG_BT_BLE_EXT_ADV=y

# Console: prefer USB Serial/JTAG on chips that support it to avoid
# UART0 conflicts with MAVLink/serial peripherals.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_UART_CUSTOM=n
CONFIG_ESP_CONSOLE_NONE=n

# ---------------------------------------------------------------------------
# OPTIONAL PRODUCTION HARDENING - Secure Boot v2 + Flash Encryption
# ---------------------------------------------------------------------------
# The options below are deliberately LEFT DISABLED (commented out).
#
# Enabling Secure Boot or Flash Encryption is a ONE-WAY operation on the
# device: it burns eFuses and cannot be reverted or undone in the field.  Do it
# only after the signing/encryption keys have been generated and backed up, and
# only on hardware you can afford to lose.  Turning either option on here
# without provisioning keys WILL produce a build that cannot boot.
#
# The full, step-by-step procedure (key generation, keyring, first encrypted
# flash, eFuse read/write protection, recovery mode, and the exact
# `idf.py menuconfig` paths) is documented in `docs/security-hardening.md`.
#
# What each option protects against:
#   * Secure Boot   -> prevents RUNNING modified/unauthorised firmware.
#     It does NOT prevent disassembling a firmware image that is distributed.
#   * Flash Encryption -> prevents READING flash contents (firmware image and
#     the NVS partition that holds the WiFi password and Ed25519 keys) with
#     physical access.
#
# CONFIG_SECURE_BOOT=y
# CONFIG_SECURE_BOOT_V2_ENABLED=y
# CONFIG_SECURE_FLASH_ENC_ENABLED=y
# CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y
# CONFIG_EFUSE_VIRTUAL=n
#
# For development-only testing WITHOUT burning eFuses (never ship this):
# CONFIG_SECURE_BOOT_INSECURE=y
# CONFIG_EFUSE_VIRTUAL=y
